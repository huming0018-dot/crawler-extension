{
  "manifest_version": 3,
  "minimum_chrome_version": "120",
  "name": "众包公开笔记采集",
  "version": "4.1.1",
  "description": "自愿参与、自动任务与公开网页采集，验证与奖励分账，遇到验证或限流立即暂停。",
  "permissions": [
    "storage",
    "alarms",
    "webNavigation"
  ],
  "host_permissions": [
    "https://www.xiaohongshu.com/*",
    "https://m.xiaohongshu.com/*",
    "https://bdwrhshgdeghgyzwpxnl.supabase.co/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "scripts": [
      "src/config.js",
      "src/core.js",
      "src/api.js",
      "src/agent.js",
      "src/join.js",
      "src/background.js"
    ]
  },
  "action": {
    "default_title": "众包公开笔记采集",
    "default_popup": "src/controller.html"
  },
  "options_page": "src/controller.html",
  "content_scripts": [
    {
      "matches": [
        "https://www.xiaohongshu.com/*",
        "https://m.xiaohongshu.com/*"
      ],
      "js": [
        "src/core.js",
        "src/content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "icons": {
    "128": "icons/icon128.png"
  },
  "key": "",
  "browser_specific_settings": {
    "gecko": {
      "id": "crowd-meishijia@huming0018-dot.github.io",
      "strict_min_version": "126.0",
      "data_collection_permissions": {
        "required": [
          "websiteContent"
        ]
      }
    }
  }
}
